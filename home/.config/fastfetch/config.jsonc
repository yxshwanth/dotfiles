{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "keyColor": "magenta"
    },
    "separator",
    {
      "type": "os",
      "key": "  os       ",
      "keyColor": "magenta"
    },
    {
      "type": "host",
      "key": "  host     ",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "  kernel   ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "  uptime   ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  packages ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "  shell    ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "  terminal ",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "  cpu      ",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "  gpu      ",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "󰍛  memory   ",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "  disk     ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
